    "red_min_exclusive": 35,
    "red_to_blue_min_exclusive": 1.3,
    "note": "Exclude blurred shadows; brightest white side gives the clearest outline. Threshold sensitivity records the few-pixel ambiguity."
  },
  "cutout_measurement": {
